# Postgres (docker compose expone 5433)
DATABASE_URL=postgres://thesis:thesis@localhost:5433/thesis

# Razonador. Sin REASONER se elige solo: ANTHROPIC_API_KEY presente → anthropic; si no, keys de Gemini → gemini.
# REASONER=gemini|anthropic fuerza uno.
#REASONER=gemini

# Anthropic (razonador). Modelo opcional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini free tier (Google AI Studio, https://aistudio.google.com). Hasta 4 keys con rotación:
# la cuota es por proyecto de Google Cloud y por modelo. Solo Flash está en el free tier.
GOOGLE_AI_API_KEY_1=
GOOGLE_AI_API_KEY_2=
GOOGLE_AI_API_KEY_3=
GOOGLE_AI_API_KEY_4=
# Orden de modelos a rotar (opcional). Default: gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
#GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash

# Alpaca PAPER. ALPACA_PAPER=false está bloqueado en v1.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# SEC exige User-Agent con contacto real
SEC_USER_AGENT=thesis-engine tu-nombre tu-email@dominio.com

# Opcionales
# Finnhub (gratis): perfil de empresa para el panel de riesgo de Cartera (país, industria). Sin key, el país sale del mercado de la posición.
FINNHUB_API_KEY=
# Veredicto diario de la cartera real (después de la corrida de tesis)
CARTERA_CRON=45 7 * * 1-5
# Radar: barrido semanal (domingo 20:00), refresco diario, plan mensual (día 1 08:00)
RADAR_SCAN_CRON=0 20 * * 0
RADAR_REFRESH_CRON=50 7 * * 1-5
RADAR_PLAN_CRON=0 8 1 * *
COURTLISTENER_TOKEN=
PORT=3001
MIN_EDGE=0.10
MAX_CANDIDATES=8
CAPITAL_USD=100000
DAILY_CRON=30 7 * * 1-5
