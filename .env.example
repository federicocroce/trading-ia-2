# Postgres (docker compose expone 5433)
DATABASE_URL=postgres://thesis:thesis@localhost:5433/thesis

# Anthropic (razonador). Modelo opcional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alpaca PAPER. ALPACA_PAPER=false está bloqueado en v1.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# SEC exige User-Agent con contacto real
SEC_USER_AGENT=thesis-engine tu-nombre tu-email@dominio.com

# Opcionales
COURTLISTENER_TOKEN=
PORT=3001
MIN_EDGE=0.10
MAX_CANDIDATES=8
CAPITAL_USD=100000
DAILY_CRON=30 7 * * 1-5
