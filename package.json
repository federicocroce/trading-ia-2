{
  "name": "thesis-engine",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @thesis/db generate",
    "db:migrate": "pnpm --filter @thesis/db migrate",
    "dev": "pnpm db:up && pnpm db:migrate && pnpm --parallel --filter @thesis/api --filter @thesis/web dev",
    "dev:api": "pnpm --filter @thesis/api dev",
    "dev:web": "pnpm --filter @thesis/web dev",
    "run:daily": "pnpm --filter @thesis/api run:daily",
    "run:sync": "pnpm --filter @thesis/api run:sync",
    "smoke:sources": "pnpm --filter @thesis/api exec tsx src/smoke-sources.ts",
    "import:v1": "pnpm --filter @thesis/api import:v1",
    "radar:scan": "pnpm --filter @thesis/api radar:scan",
    "radar:rank": "pnpm --filter @thesis/api radar:rank",
    "radar:refresh": "pnpm --filter @thesis/api radar:refresh",
    "radar:plan": "pnpm --filter @thesis/api radar:plan",
    "radar:argentina": "pnpm --filter @thesis/api radar:argentina"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
